{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/lhci-server.mjs",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/catalogo",
        "http://localhost:4321/producto/llaveros-con-nombre",
        "http://localhost:4321/privacidad",
        "http://localhost:4321/catalogo/navidad",
        "http://localhost:4321/aprende",
        "http://localhost:4321/aprende/filamentos",
        "http://localhost:4321/aprende/filamentos/pla"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
