---
// Product photo gallery: a carousel with previous/next buttons, a counter and a thumbnail strip.
// With one photo there are no controls; with none, an empty placeholder. The script drives it
// with Embla.
import { es } from '@/i18n/es';
import { type PhotoSrc, photoImg } from '@/lib/photos';
import Picture from '@/components/site/Picture.astro';

interface Props {
  photos: PhotoSrc[];
  imgBase: string;
}
const { photos, imgBase } = Astro.props;
const t = es.product;
// Buttons, counter and thumbnails only exist with more than one photo.
const many = photos.length > 1;
---

{photos.length === 0 ? (
  <div class="aspect-square rounded-[22px] bg-soft" />
) : (
  <section aria-roledescription="carousel" aria-label={t.galleryLabel} data-gallery>
    <div class="relative overflow-hidden rounded-[22px] bg-soft">
      <div data-viewport class="overflow-hidden">
        <div class="flex touch-pan-y">
          {photos.map((p, i) => (
            <div
              class="aspect-square min-w-0 flex-[0_0_100%]"
              role="group"
              aria-roledescription="slide"
              aria-label={t.counter(i + 1, photos.length)}
            >
              <Picture
                photo={p}
                imgBase={imgBase}
                sizes="(max-width: 760px) 100vw, 640px"
                priority={i === 0}
                class="size-full object-cover"
              />
            </div>
          ))}
        </div>
      </div>
      {many && (
        <>
          <button
            type="button"
            data-prev
            aria-label={t.previous}
            class="absolute top-1/2 left-3.5 grid size-11 -translate-y-1/2 place-items-center rounded-[10px] bg-white/90 text-xl shadow-[0_2px_8px_rgba(18,18,20,.1)] disabled:opacity-40"
          >
            ←
          </button>
          <button
            type="button"
            data-next
            aria-label={t.next}
            class="absolute top-1/2 right-3.5 grid size-11 -translate-y-1/2 place-items-center rounded-[10px] bg-white/90 text-xl shadow-[0_2px_8px_rgba(18,18,20,.1)] disabled:opacity-40"
          >
            →
          </button>
          <span
            data-counter
            data-total={photos.length}
            aria-live="polite"
            class="absolute right-3.5 bottom-3.5 rounded-md bg-white/90 px-[9px] py-[3px] text-[13px] text-ink-2"
          >
            {t.counter(1, photos.length)}
          </span>
        </>
      )}
    </div>
    {many && (
      <div data-thumbs class="mt-3 overflow-hidden">
        <div class="flex gap-2.5 pb-1">
          {photos.map((p, i) => (
            <button
              type="button"
              data-thumb={i}
              aria-label={t.thumb(i + 1)}
              aria-current={i === 0 ? 'true' : undefined}
              class="size-[76px] flex-none overflow-hidden rounded-xl bg-soft p-0 aria-[current]:shadow-[inset_0_0_0_2px_var(--ink)]"
            >
              <img
                src={photoImg({ ...p, widths: [Math.min(...p.widths)] }, imgBase).src}
                width="76"
                height="76"
                alt=""
                loading="lazy"
                class="size-full object-cover"
              />
            </button>
          ))}
        </div>
      </div>
    )}
  </section>
)}

<script>
  import EmblaCarousel, { type EmblaCarouselType } from 'embla-carousel';
  import { es } from '@/i18n/es';

  // Starts on astro:page-load and cleans on astro:before-swap (CLAUDE.md rule 13).
  // Each gallery gets a main carousel and a thumbnail one; buttons, counter and the current
  // thumbnail follow the selected slide.
  const apis: EmblaCarouselType[] = [];
  const cleanups: (() => void)[] = [];

  function setup() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
      const viewport = root.querySelector<HTMLElement>('[data-viewport]');
      if (!viewport) return;
      const main = EmblaCarousel(viewport, { loop: false, align: 'start' });
      apis.push(main);
      const thumbsEl = root.querySelector<HTMLElement>('[data-thumbs]');
      const thumbs = thumbsEl
        ? EmblaCarousel(thumbsEl, { containScroll: 'keepSnaps', dragFree: true, align: 'start' })
        : null;
      if (thumbs) apis.push(thumbs);
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      const counter = root.querySelector<HTMLElement>('[data-counter]');
      const dots = [...root.querySelectorAll<HTMLElement>('[data-thumb]')];

      // Brings buttons, counter, current thumbnail and thumbnail scroll in line with the slide.
      const sync = () => {
        const i = main.selectedScrollSnap();
        if (prev) prev.disabled = !main.canScrollPrev();
        if (next) next.disabled = !main.canScrollNext();
        if (counter) counter.textContent = es.product.counter(i + 1, Number(counter.dataset.total));
        dots.forEach((d, n) =>
          n === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current'),
        );
        thumbs?.scrollTo(i);
      };
      const onPrev = () => main.scrollPrev();
      const onNext = () => main.scrollNext();
      const dotHandlers = dots.map((d, n) => {
        const fn = () => main.scrollTo(n);
        d.addEventListener('click', fn);
        return [d, fn] as const;
      });
      prev?.addEventListener('click', onPrev);
      next?.addEventListener('click', onNext);
      main.on('select', sync).on('reInit', sync);
      sync();
      cleanups.push(() => {
        prev?.removeEventListener('click', onPrev);
        next?.removeEventListener('click', onNext);
        dotHandlers.forEach(([d, fn]) => d.removeEventListener('click', fn));
      });
    });
  }

  function cleanup() {
    cleanups.splice(0).forEach((fn) => fn());
    apis.splice(0).forEach((api) => api.destroy());
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', cleanup);
</script>
