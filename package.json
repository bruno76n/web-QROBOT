{
  "name": "quick-robot-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-assets.mjs && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "e2e": "playwright test && playwright test -c playwright.admin.config.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:negative": "node scripts/lint-negative.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/build-assets.mjs && astro check",
    "security": "node scripts/security.mjs",
    "size": "node scripts/size-check.mjs",
    "lhci": "lhci autorun",
    "assets": "node scripts/build-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
    "deploy": "wrangler deploy",
    "seed": "node scripts/setup-local.mjs && node scripts/seed.ts",
    "e2e:public": "playwright test",
    "e2e:admin": "playwright test -c playwright.admin.config.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "r2:orphans": "node scripts/r2-orphans.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^7.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sindresorhus/slugify": "^4.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "astro": "^7.4.5",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "heic2any": "^0.0.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "geist": "^1.9.0",
    "globals": "^17.14.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "three-stdlib": "^2.36.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
