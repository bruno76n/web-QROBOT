---
// Site footer: logo, contact data from `site.ts`, links to the sections (Catálogo, Aprende), legal line with the privacy link, and the brand
// name set across the full width of the container.
import { es } from '@/i18n/es';
import { site } from '@/config/site';
import Logo from './Logo.astro';

// Year shown in the legal line.
const year = new Date().getFullYear();
// Contact entries; only those with a `url` render as links.
const contacts = [
  { label: es.footer.whatsapp, value: site.whatsappLabel, url: null as string | null },
  { label: es.footer.facebook, value: site.facebook.label, url: site.facebook.url },
  { label: es.footer.instagram, value: site.instagram.label, url: site.instagram.url },
];
---

<footer class="border-t border-line">
  <div class="wrap flex flex-wrap items-start justify-between gap-x-12 gap-y-6 pt-[34px] pb-11">
    <a href="/" aria-label={es.a11y.goHome} class="flex items-center no-underline">
      <Logo size={26} />
    </a>
    <div class="flex flex-wrap gap-12">
      {contacts.map((c) => (
        <p class="text-[15px]">
          <span class="block text-[13px] text-ink-2">{c.label}</span>
          {c.url ? (
            <a href={c.url} target="_blank" rel="noopener">
              {c.value}
            </a>
          ) : (
            c.value
          )}
        </p>
      ))}
    </div>
    <nav aria-label={es.footer.navLabel} class="flex w-full flex-wrap gap-x-7 text-[15px]">
      {es.header.nav.map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-11 items-center text-ink-2 no-underline hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <p class="w-full text-[13px] text-ink-2">
      {es.footer.legal(year)} · <a href="/privacidad">{es.footer.privacy}</a>
    </p>
  </div>
  <!-- The name spans the exact width of the container: font-size in cqw, no JS (docs/11 §2). -->
  <div class="wrap overflow-hidden pb-[clamp(10px,1.6vw,26px)]" aria-hidden="true">
    <div class="footer-name">
      <span>{es.site.name}</span>
    </div>
  </div>
</footer>

<style>
  /* Container-query unit base for the font size below. */
  .footer-name {
    container-type: inline-size;
  }
  .footer-name > span {
    display: block;
    white-space: nowrap;
    font-weight: 600;
    letter-spacing: -0.068em;
    line-height: 0.82;
    /* 100cqw divided by the text width at 1em, measured for Geist 600, so the name fills the row. */
    font-size: calc(100cqw / 5.168);
  }
</style>
