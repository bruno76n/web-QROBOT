---
/**
 * Header of a section of the page for workshops (docs/25 §6.2, mockup `.sec-h`): the `h2` and, if
 * given, its sentence. No double rule and no label above the title (§7).
 */

interface Props {
  /** Id of the heading, for the section's `aria-labelledby`. */
  id: string;
  title: string;
  lead?: string;
}
const { id, title, lead } = Astro.props;
---

<header class="sec-h">
  <h2 class="t-h2" id={id}>
    {title}
  </h2>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  /* Grid gap with its Safari 14 alias. */
  .sec-h {
    display: grid;
    grid-gap: 16px;
    gap: 16px;
    margin-bottom: clamp(32px, 4.4vw, 56px);
    max-width: 860px;
  }
</style>
