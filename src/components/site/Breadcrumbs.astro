---
// Breadcrumb trail as a `<nav>` with an ordered list. Items with `href` are links; the item
// without one (the last) is the current page.
import { es } from '@/i18n/es';

interface Props {
  /** Trail in order, from the first level to the current page. */
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label={es.catalog.breadcrumbLabel} class="pt-[clamp(26px,3vw,40px)] text-sm text-ink-2">
  <ol class="m-0 flex list-none flex-wrap gap-x-2 p-0">
    {items.map((item, i) => (
      <li class="flex gap-2">
        {item.href ? (
          <a href={item.href} class="text-ink-2 no-underline hover:text-ink">
            {item.label}
          </a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
