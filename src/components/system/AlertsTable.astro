---
/**
 * The 7 alerts of the system's home screen (docs/25 §6.2, mockup `.alerts`): the alert, when it
 * shows up and the drawn button that resolves it. On phones (≤ 760 px) the header hides and each
 * row stacks the alert over its condition, with the action on the right. The table frame and
 * cells are the shared `.tbl-wrap` of `system.css`.
 */
import { alerts } from '@/config/system';
import { es } from '@/i18n/es';

const t = es.system.home.alerts;
const rows = alerts.map((id) => t.items[id]);
---

<div class="tbl-wrap">
  <table class="alerts">
    <caption class="sr-only">{t.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{t.head.alert}</th>
        <th scope="col">{t.head.when}</th>
        <th scope="col">{t.head.action}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.name}</th>
          <td>{r.when}</td>
          <td>
            <span class="act">{r.action}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .alerts {
    background: #fff;
  }
  .alerts th,
  .alerts td {
    vertical-align: middle;
  }
  .alerts thead th {
    background: var(--soft);
  }
  .alerts tbody th {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    background: #fff;
    white-space: normal;
    text-align: left;
  }
  .alerts td {
    color: var(--ink-2);
  }
  /* The action, drawn as a small button (not a real one: the page only describes the system). */
  .act {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 7px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }
  /* Phones: stacked rows, the action on the right (column gap with its Safari 14 alias). */
  @media (max-width: 760px) {
    .alerts thead {
      display: none;
    }
    .alerts tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-column-gap: 12px;
      column-gap: 12px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      align-items: center;
    }
    .alerts tr:last-child {
      border-bottom: 0;
    }
    .alerts th,
    .alerts td {
      padding: 0;
      border: 0;
    }
    .alerts tbody th {
      grid-column: 1;
    }
    .alerts td:nth-child(2) {
      grid-column: 1;
      grid-row: 2;
      font-size: 15px;
    }
    .alerts td:nth-child(3) {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
