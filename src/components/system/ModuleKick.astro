---
/**
 * Name of the module above the title of a section (docs/25 §6.2, mockup `.kick`): the same icon
 * and name as in the system menu, in the brand purple. In a dark section (`FeatureSection dark`)
 * it turns light.
 */
import ModuleIcon from './ModuleIcon.astro';
import type { IconKey } from '@/config/system';

interface Props {
  icon: IconKey;
  label: string;
}
const { icon, label } = Astro.props;
---

<p class="kick">
  <span class="kick-ic">
    <ModuleIcon icon={icon} size={18} />
  </span>
  {label}
</p>

<style>
  .kick {
    display: flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--purple);
    margin-bottom: 18px;
  }
  .kick-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--lilac);
    margin-right: 10px;
    flex: none;
  }
  :global(.feat.dark) .kick {
    color: #cdbcf8;
  }
  :global(.feat.dark) .kick-ic {
    background: rgba(255, 255, 255, 0.08);
  }
</style>
