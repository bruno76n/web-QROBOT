---
// The page for workshops: main page (docs/25 §7.1). Hidden until the system is out (docs/25 §2):
// the middleware locks `/talleres` and this page locks itself too; never prerendered.
import SystemLayout from '@/layouts/SystemLayout.astro';
import SectionHead from '@/components/system/SectionHead.astro';
import PlanBand from '@/components/system/PlanBand.astro';
import EndCta from '@/components/system/EndCta.astro';
import { site } from '@/config/site';
import { systemVisible } from '@/config/system';
import { es } from '@/i18n/es';
import { systemBase } from '@/lib/system/visibility';

export const prerender = false;
if (!systemVisible) return Astro.rewrite('/404');

const { name, trialDays, appUrl, signUpPath } = site.system;
const t = es.system.home;
const seo = es.system.seo.home(name);
---

<SystemLayout title={seo.title} description={seo.description} current="home">
  <section aria-labelledby="h1">
    <div class="wrap">
      <h1 class="t-h1" id="h1">
        {t.title}
      </h1>
    </div>
  </section>

  <section class="band-soft" aria-labelledby="price-h">
    <div class="wrap">
      <SectionHead id="price-h" title={t.pricing.title} lead={t.pricing.lead} />
      <PlanBand />
      <p class="plans-more">
        <a class="link" href={`${systemBase}/precios`}>
          {es.system.cta.comparePlans}
        </a>
      </p>
    </div>
  </section>

  <EndCta
    id="end-h"
    title={t.end.title}
    lead={t.end.lead(trialDays)}
    primary={{ label: es.system.cta.tryFree, href: `${appUrl}${signUpPath}` }}
    secondary={{ label: es.system.cta.download, href: `${systemBase}/descargar` }}
  />
</SystemLayout>

<style>
  .plans-more {
    margin-top: 22px;
  }
</style>
