---
/**
 * Monthly or yearly toggle of the pricing page (docs/25 §6–7.2, mockup `.seg`). Two pressed-state
 * buttons; the behavior is in src/scripts/system-period.ts, which swaps the price texts that the
 * plan band already carries and tells the plan finder. Without JavaScript the monthly prices stay,
 * each with its yearly line below.
 */
import { es } from '@/i18n/es';

const t = es.system.pricing.period;
---

<div class="seg" role="group" aria-label={t.label} data-period-toggle>
  <button type="button" data-period="monthly" aria-pressed="true">
    {t.monthly}
  </button>
  <button type="button" data-period="yearly" aria-pressed="false">
    {t.yearly}
    <small>{t.yearlyNote}</small>
  </button>
</div>

<script>
  import '@/scripts/system-period';
</script>

<style>
  /* Segmented control: the pressed option is a white chip over the soft background. */
  .seg {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 3px;
    background: var(--soft);
  }
  .seg button {
    border: 0;
    background: transparent;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 7px;
    font: inherit;
    font-size: 15px;
    cursor: pointer;
    color: var(--ink-2);
  }
  .seg button[aria-pressed='true'] {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
  /* Small green text over the soft background: `--green-text` reaches 4.5:1 (axe). */
  .seg small {
    font-size: 12px;
    color: var(--green-text);
    margin-left: 6px;
  }
</style>
