---
// Test page `/dev/ui-costo-pedidos`: the screens «Costo de una pieza» (`UiPiece`) and «Pedido»
// (`UiOrder`) inside the module sections of the page for workshops, with the same variants as the
// mockup (`#costo` plain, `#pedidos` `rev soft`) so the screens get the same width. Only exists in
// `astro dev` (404 otherwise); it carries `noindex` and is not linked anywhere.
import SystemLayout from '@/layouts/SystemLayout.astro';
import FeatureSection from '@/components/system/FeatureSection.astro';
import UiOrder from '@/components/system/ui/UiOrder.astro';
import UiPiece from '@/components/system/ui/UiPiece.astro';
import { es } from '@/i18n/es';

// Test page: development only (docs/10 §9).
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

// Filler texts of the sections: the module names and sentences.
const m = es.system.modules;
const specs = (ids: readonly (keyof typeof m)[]) =>
  ids.map((id) => ({ name: m[id].name, text: m[id].text }));
---

<SystemLayout title="UI costo y pedidos (dev)" description="" current="home">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <FeatureSection
    id="costo"
    kick={{ icon: 'cost', label: m.products.name }}
    title={m.products.text}
    lead={m.products.text}
    specs={specs(['products', 'sales', 'customers', 'expenses', 'printers'])}
  >
    <UiPiece />
  </FeatureSection>

  <FeatureSection
    id="pedidos"
    kick={{ icon: 'orders', label: m.orders.name }}
    title={m.orders.text}
    lead={m.orders.text}
    specs={specs(['orders', 'stock', 'printers', 'filaments', 'production'])}
    rev
    soft
  >
    <UiOrder />
  </FeatureSection>
</SystemLayout>
