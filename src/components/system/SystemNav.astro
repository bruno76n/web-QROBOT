---
/**
 * Product bar of the page for workshops (docs/25 §7, mockup `.pbar`): icon and name, Módulos ·
 * Precios · Descargar, «Iniciar sesión» and «Probar gratis». It stays on top while the site header scrolls
 * away. On phones (≤ 760 px) the links and «Iniciar sesión» move into a `<details>` menu that opens and
 * closes with the keyboard, without scripts. «Iniciar sesión» and «Probar gratis» lead to the system.
 */
import Button from '@/components/site/Button.astro';
import Logo from '@/components/site/Logo.astro';
import { site } from '@/config/site';
import { es } from '@/i18n/es';
import { systemBase } from '@/lib/system/visibility';

export type SystemPage = 'home' | 'pricing' | 'download';

interface Props {
  current: SystemPage;
}
const { current } = Astro.props;
const t = es.system.nav;
const { name, appUrl, signInPath, signUpPath } = site.system;

const links: { id: SystemPage; label: string; href: string }[] = [
  { id: 'home', label: t.modules, href: `${systemBase}#modulos` },
  { id: 'pricing', label: t.pricing, href: `${systemBase}/precios` },
  { id: 'download', label: t.download, href: `${systemBase}/descargar` },
];
const signIn = `${appUrl}${signInPath}`;
const signUp = `${appUrl}${signUpPath}`;
---

<div class="pbar">
  <div class="wrap pbar-in">
    <a class="pname" href={systemBase}>
      <span class="picon">
        <Logo withName={false} size={22} />
      </span>
      {name}
    </a>
    <nav class="plinks" aria-label={name}>
      {links.map((l) => (
        <a href={l.href} aria-current={l.id === current ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <details class="pmenu">
      <summary aria-label={t.menu(name)}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>
      <nav class="pmenu-list" aria-label={name}>
        {links.map((l) => (
          <a href={l.href} aria-current={l.id === current ? 'page' : undefined}>
            {l.label}
          </a>
        ))}
        <a href={signIn} rel="noopener">
          {t.signIn}
        </a>
      </nav>
    </details>
    <div class="pright">
      <a class="enter" href={signIn} rel="noopener">
        {t.signIn}
      </a>
      <Button href={signUp} size="sm" rel="noopener" class="ptry">
        {t.tryFree}
      </Button>
    </div>
  </div>
</div>

<style>
  .pbar {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 45;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    /* The bar sits outside `.system`: its height is set here too. */
    --pbar: 60px;
  }
  .pbar-in {
    display: flex;
    align-items: center;
    height: var(--pbar);
    position: relative;
  }
  /* Spacing with margins, not `gap` in flex (Safari 14, docs/24 §5). */
  .pbar-in > * + * {
    margin-left: 20px;
  }
  .pname {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .picon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--ink);
    margin-right: 10px;
    flex: none;
  }
  .plinks {
    display: flex;
  }
  .plinks a {
    font-size: 15px;
    color: var(--ink-2);
    text-decoration: none;
    padding: 0 10px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .plinks a:hover,
  .plinks a[aria-current] {
    color: var(--ink);
  }
  .plinks a[aria-current] {
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .pright {
    margin-left: auto !important;
    display: flex;
    align-items: center;
  }
  .pright > * + * {
    margin-left: 16px;
  }
  .enter {
    font-size: 15px;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .pmenu {
    display: none;
  }
  @media (max-width: 760px) {
    .pbar {
      --pbar: 54px;
    }
    .plinks,
    .enter {
      display: none;
    }
    .pbar-in > * + * {
      margin-left: 8px;
    }
    .pname {
      font-size: 17px;
    }
    .picon {
      width: 30px;
      height: 30px;
      margin-right: 8px;
    }
    .pmenu {
      display: block;
    }
    .pmenu summary {
      list-style: none;
      cursor: pointer;
      width: 44px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
    }
    .pmenu summary::-webkit-details-marker {
      display: none;
    }
    .pmenu summary svg {
      transition: transform 0.18s ease;
    }
    .pmenu[open] summary svg {
      transform: rotate(180deg);
    }
    .pmenu-list {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(var(--pbar) - 1px);
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgba(18, 18, 20, 0.25);
      padding: 6px max(var(--gutter), env(safe-area-inset-left, 0px)) 14px;
    }
    .pmenu-list a {
      display: flex;
      align-items: center;
      min-height: 52px;
      border-bottom: 1px solid var(--line);
      text-decoration: none;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.03em;
    }
    .pmenu-list a:last-child {
      border-bottom: 0;
    }
    .pmenu-list a[aria-current] {
      color: var(--purple);
    }
  }
  @media (max-width: 480px) {
    .pname {
      font-size: 16px;
    }
    .pright :global(.ptry) {
      padding: 0 12px;
      font-size: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pmenu summary svg {
      transition: none;
    }
  }
</style>
