---
/**
 * Horizontal bar of a chart in a system screen (docs/25 §6.3): only the value, its width as an SVG
 * attribute from `pct`. Gray by default (costs); `green` only for profit.
 */
import { pct } from '@/lib/system/bars';

interface Props {
  value: number;
  max: number;
  green?: boolean;
  /** Height in px. */
  height?: number;
  class?: string | undefined;
}
const { value, max, green = false, height = 8, class: className } = Astro.props;
---

<svg
  class:list={['ui-hbar', green ? 'green' : 'ink', className]}
  width="100%"
  height={height}
  aria-hidden="true"
>
  <rect class="v" width={`${pct(value, max)}%`} height={height} rx="2"></rect>
</svg>
