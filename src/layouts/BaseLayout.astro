---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { es } from '@/i18n/es';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

// Basic head only; the full SEO (canonical, Open Graph, JSON-LD) arrives in phase 3.
const { title = es.site.title, description = es.site.description } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="vh focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:h-auto focus:w-auto focus:rounded-btn focus:bg-ink focus:px-4 focus:py-3 focus:text-white focus:[clip:auto]"
    >
      {es.a11y.skipToContent}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
