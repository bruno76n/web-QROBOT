---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Picture from '@/components/site/Picture.astro';
import { es } from '@/i18n/es';

// Provisional home (phase 1): the real sections arrive in phase 4.
---

<BaseLayout>
  <section class="wrap flex flex-col items-center gap-6 py-[clamp(70px,9vw,130px)] text-center">
    <span class="dl"></span>
    <Picture
      base="/brand/q404/q404-morado-verde"
      widths={[265, 530]}
      sizes="200px"
      width={530}
      height={840}
      alt={es.underConstruction.imageAlt}
      priority
      class="h-auto w-[200px]"
    />
    <h1 class="text-[clamp(36px,4.6vw,68px)] leading-[1.02]">{es.underConstruction.title}</h1>
    <p class="lead max-w-[30ch] text-balance">{es.underConstruction.text}</p>
  </section>
</BaseLayout>
