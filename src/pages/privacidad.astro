---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import { es } from '@/i18n/es';

// Static page: no data, no island (docs/04 §1).
export const prerender = true;
const t = es.privacy;
---

<BaseLayout title={`${t.title} · ${site.name}`} description={t.metaDescription}>
  <article class="wrap max-w-[760px] py-[clamp(40px,6vw,90px)]">
    <h1 class="text-[clamp(34px,4.4vw,62px)] leading-[1.02]">{t.title}</h1>
    <p class="lead mt-5">{t.lead}</p>
    <p class="mt-3 text-[13px] text-ink-2">{t.updated(site.privacyUpdated)}</p>
    {t.sections.map((s) => (
      <section class="mt-10" aria-labelledby={`p-${s.id}`}>
        <h2 id={`p-${s.id}`} class="text-[22px] leading-tight">
          {s.title}
        </h2>
        {s.body(site.owner).map((p) => (
          <p class="mt-3 text-[16px] leading-relaxed text-ink-2">{p}</p>
        ))}
      </section>
    ))}
  </article>
</BaseLayout>
