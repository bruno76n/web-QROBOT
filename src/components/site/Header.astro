---
// Site header: logo, main navigation (from `siteNav`) and quote button. Sticky by default; the
// page for workshops lets it scroll away so its own bar stays on top (`sticky={false}`). On the home
// page, while the hero is on screen, the logo gives way to an invitation to follow on Instagram (see
// the script).
import { es } from '@/i18n/es';
import { site } from '@/config/site';
import Logo from './Logo.astro';
import Button from './Button.astro';
import { systemVisible } from '@/config/system';
import { siteNav } from '@/lib/nav';

interface Props {
  /** Stays on top while scrolling (default); `false` lets it scroll away with the page. */
  sticky?: boolean;
}
const { sticky = true } = Astro.props;
// Menu links; «Para talleres» joins only while the page for workshops is visible (docs/25 §2).
const nav = siteNav(systemVisible);
// With three links, on the narrowest phones (≤ 380 px) they lose some padding so they fit next to
// the logo and Cotizar (docs/24 §3).
const crowded = nav.length > 2;

const current = Astro.url.pathname;
// A nav item is current when the path starts with its `href`; links with a hash never are.
const isCurrent = (href: string) => !href.includes('#') && current.startsWith(href);
---

<header
  id="top"
  data-top
  class:list={[
    'group/top top-0 z-50 bg-white shadow-[0_1px_0_var(--line)] transition-shadow duration-300 data-[over-hero]:shadow-none',
    sticky ? 'sticky' : 'relative',
  ]}
>
  <div class="wrap grid min-h-[var(--top)] max-w-none grid-cols-[1fr_auto_auto] items-center gap-x-1 min-[901px]:grid-cols-[1fr_auto_1fr] min-[901px]:gap-x-0">
    <div class="col-start-1 grid min-w-0 items-center *:[grid-area:1/1]">
      <span class="pointer-events-none invisible text-[12px] leading-[1.2] text-balance text-ink-2 min-[901px]:text-[14px] min-[901px]:leading-normal opacity-0 transition-[opacity,visibility] duration-300 group-data-[over-hero]/top:pointer-events-auto group-data-[over-hero]/top:visible group-data-[over-hero]/top:opacity-100">
        <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
          {/* On small phones only the button fits next to Catálogo, Aprende and Cotizar (docs/24 §3). */}
          <span class="max-[480px]:hidden">{es.header.social.lead}</span>
          {site.instagram.url && (
            <Button
              href={site.instagram.url}
              size="sm"
              target="_blank"
              rel="noopener"
              class="min-h-8 !px-3 !text-[13px] border border-line bg-white text-ink hover:bg-soft min-[901px]:min-h-10 min-[901px]:!px-[18px] min-[901px]:!text-[15px]"
            >
              {es.header.social.button}
            </Button>
          )}
        </span>
      </span>
      <a
        href="/"
        aria-label={es.a11y.goHome}
        class="flex items-center no-underline transition-[opacity,visibility] duration-300 group-data-[over-hero]/top:pointer-events-none group-data-[over-hero]/top:invisible group-data-[over-hero]/top:opacity-0"
      >
        <Logo compact />
      </a>
    </div>

    <nav
      aria-label={es.a11y.mainNav}
      class:list={[
        'col-start-2 flex items-center gap-1 min-[901px]:min-h-[54px] min-[901px]:self-start min-[901px]:rounded-b-[16px] min-[901px]:bg-ink min-[901px]:px-3.5',
        crowded && 'max-[380px]:gap-0',
      ]}
    >
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center px-2.5 text-[15px] text-ink max-[480px]:px-[7px] min-[901px]:px-3.5 no-underline transition-colors duration-200 min-[901px]:text-[#c3c3cc] min-[901px]:hover:text-white aria-[current]:font-semibold min-[901px]:aria-[current]:text-white',
            crowded && 'max-[380px]:px-1',
          ]}
        >
          {item.short ? (
            <>
              {/* ≤ 480 px shows the short name; screen readers always get the full one. */}
              <span class="max-[480px]:sr-only">{item.label}</span>
              <span class="hidden max-[480px]:inline" aria-hidden="true">
                {item.short}
              </span>
            </>
          ) : (
            item.label
          )}
        </a>
      ))}
    </nav>

    <Button
      href={es.header.quoteHref}
      size="sm"
      class="col-start-3 justify-self-end max-[760px]:!px-3.5 max-[760px]:!text-[14px]"
    >
      {es.header.quote}
    </Button>
  </div>
</header>

<script>
  // The home page has an element with `data-hero` at the top. While it is on
  // screen the header shows the social-links invitation instead of the logo (class `data-over-hero`).
  // Page scripts start on `astro:page-load` and clean up on `astro:before-swap` (CLAUDE.md §13).
  let observer: IntersectionObserver | undefined;

  function setup() {
    const header = document.querySelector<HTMLElement>('[data-top]');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!header) return;
    if (!hero) {
      header.removeAttribute('data-over-hero');
      return;
    }
    const topPx = header.getBoundingClientRect().height;
    observer = new IntersectionObserver(
      ([entry]) => {
        header.toggleAttribute('data-over-hero', Boolean(entry?.isIntersecting));
      },
      { rootMargin: `-${topPx}px 0px 0px 0px`, threshold: 0 },
    );
    observer.observe(hero);
  }

  function cleanup() {
    observer?.disconnect();
    observer = undefined;
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', cleanup);
</script>
