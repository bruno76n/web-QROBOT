{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quick-robot-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "quickrobot.centerdiv.mx", "custom_domain": true }],

  // Defaults are the SAFE production ones. Local development overrides them in `.dev.vars.local`
  // (APP_ENV=development, PUBLIC_IMG_BASE=/img); see `.dev.vars.example`.
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_IMG_BASE": "https://fotos-quickrobot.centerdiv.mx",
    "ACCESS_TEAM_DOMAIN": "",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quick-robot-web",
      // Placeholder: `wrangler d1 create quick-robot-web` gives the real id (docs/17). Local work ignores it.
      "database_id": "9030e709-2ce1-4876-9f82-71d2a73e8cbb",
      "migrations_dir": "migrations",
    },
  ],

  // 30 taps per minute per IP; the key is never stored (docs/13 §4).
  "ratelimits": [
    { "name": "CLICK_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "quick-robot-photos" }],
}
