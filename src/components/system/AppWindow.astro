---
/**
 * A window of the system app with one screenshot (docs/25 §6, mockup `.win`). The proportion comes
 * from `padding-top` (Safari 14 has no `aspect-ratio`). With `crop`, on phones (≤ 760 px) the box
 * turns vertical (125 %) and shows the part that matters of each screenshot (its point of
 * interest). `priority` marks the main image of the page (eager, high fetch priority).
 */
import Picture from '@/components/site/Picture.astro';
import { systemShotSize, systemShotWidths, type SystemShot } from '@/config/system';

interface Props {
  shot: SystemShot;
  alt: string;
  /** `sizes` of the image; by default it spans the content width. */
  sizes?: string;
  crop?: boolean;
  priority?: boolean;
  class?: string;
}
const {
  shot,
  alt,
  sizes = '(min-width: 1360px) 1232px, 90vw',
  crop = false,
  priority = false,
  class: className,
} = Astro.props;
---

<figure class:list={['win', className]}>
  <div class="win-bar" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
  </div>
  <div class:list={['shot', crop && 'crop']} data-shot={shot}>
    <Picture
      base={`/brand/talleres/${shot}`}
      widths={[...systemShotWidths]}
      width={systemShotSize.width}
      height={systemShotSize.height}
      sizes={sizes}
      alt={alt}
      priority={priority}
    />
  </div>
</figure>

<style>
  .win {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 42px 80px -44px rgba(18, 18, 20, 0.35),
      0 2px 6px rgba(18, 18, 20, 0.04);
  }
  .win-bar {
    height: 32px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    background: #fafafb;
  }
  .win-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #e0e0e6;
    margin-right: 7px;
  }
  .shot {
    position: relative;
    overflow: hidden;
    background: var(--soft);
  }
  .shot::before {
    content: '';
    display: block;
    padding-top: 62.5%;
  }
  .shot :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 0 0;
  }
  /* Point of interest of each screenshot: what stays in view when the box is narrower. */
  .shot[data-shot='inicio'] :global(img),
  .shot[data-shot='pedidos'] :global(img),
  .shot[data-shot='produccion'] :global(img),
  .shot[data-shot='existencias'] :global(img) {
    object-position: 30% 0;
  }
  .shot[data-shot='pieza'] :global(img) {
    object-position: 100% 0;
  }
  .shot[data-shot='reportes'] :global(img) {
    object-position: 40% 0;
  }
  @media (max-width: 760px) {
    .shot.crop::before {
      padding-top: 125%;
    }
  }
</style>
