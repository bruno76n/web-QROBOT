---
/**
 * Icon of a module of the system or of a section of the page (docs/25 §6.1): the lucide icon of
 * the system menu for each key of `config/system.ts`. Decorative (`aria-hidden`): the module name
 * is always written next to it. Size and color come from the parent (`currentColor`).
 */
import Archive from '@lucide/astro/icons/archive';
import Bell from '@lucide/astro/icons/bell';
import Calculator from '@lucide/astro/icons/calculator';
import ChartColumn from '@lucide/astro/icons/chart-column';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import Database from '@lucide/astro/icons/database';
import Disc from '@lucide/astro/icons/disc';
import FileText from '@lucide/astro/icons/file-text';
import House from '@lucide/astro/icons/house';
import Layers from '@lucide/astro/icons/layers';
import Package from '@lucide/astro/icons/package';
import Printer from '@lucide/astro/icons/printer';
import Receipt from '@lucide/astro/icons/receipt';
import Settings from '@lucide/astro/icons/settings';
import ShoppingBag from '@lucide/astro/icons/shopping-bag';
import ShoppingCart from '@lucide/astro/icons/shopping-cart';
import UserCog from '@lucide/astro/icons/user-cog';
import Users from '@lucide/astro/icons/users';
import Wallet from '@lucide/astro/icons/wallet';
import type { IconKey } from '@/config/system';

interface Props {
  icon: IconKey;
  /** Width and height in px. */
  size?: number;
  class?: string;
}
const { icon, size = 18, class: className } = Astro.props;

const icons = {
  home: House,
  products: Package,
  sales: Receipt,
  orders: ClipboardList,
  filaments: Disc,
  supplies: ShoppingBag,
  printers: Printer,
  production: Layers,
  stock: Archive,
  purchases: ShoppingCart,
  customers: Users,
  expenses: Wallet,
  reports: ChartColumn,
  settings: Settings,
  cost: Calculator,
  documents: FileText,
  alerts: Bell,
  team: UserCog,
  data: Database,
} satisfies Record<IconKey, unknown>;
const Icon = icons[icon];
---

<Icon
  size={size}
  stroke-width={1.8}
  {...(className ? { class: className } : {})}
  aria-hidden="true"
/>
