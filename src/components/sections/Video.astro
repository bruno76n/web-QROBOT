---
import { site } from '@/config/site';
import { es } from '@/i18n/es';

const t = es.home.video;
const hasVideo = site.video.src !== null;
---

<section
  class="sec vsec cv"
  id="video"
  aria-labelledby="h-vid"
  data-video-section
  data-src={site.video.src ?? ''}
  data-speed={site.video.speed}
>
  <div class="wrap">
    <div class="vhead">
      <h2 id="h-vid">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
  </div>
  <div class="vwide">
    <div class="vbox" data-box>
      <div class="vbox-ph" data-ph>
        <img
          class="vbg"
          src="/brand/video-poster-1200.webp"
          alt=""
          loading="lazy"
          width="1200"
          height="675"
        />
        <button
          type="button"
          class="vplay"
          data-play
          disabled={!hasVideo}
          aria-label={hasVideo ? t.playLabel : t.noVideo}
        >
          <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true">
            <path d="M8 5v14l11-7z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .vsec {
    padding-bottom: clamp(60px, 8vw, 120px);
  }
  .vhead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 60px;
    flex-wrap: wrap;
    margin-bottom: clamp(26px, 3.5vw, 44px);
  }
  .vhead :global(.lead) {
    max-width: 30ch;
  }
  .vwide {
    padding-inline: clamp(12px, 1.6vw, 26px);
  }
  .vbox {
    position: relative;
    aspect-ratio: 16/9;
    max-height: 86vh;
    width: 100%;
    border-radius: clamp(16px, 2vw, 28px);
    overflow: hidden;
    background: var(--ink);
  }
  .vbox :global(video),
  .vbox-ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .vbox :global(video) {
    object-fit: cover;
  }
  .vbg {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    max-width: none;
    object-fit: cover;
    filter: blur(3px) brightness(0.42) saturate(0.9);
    transform: scale(1.02);
    transition:
      transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.6s;
  }
  .vbox-ph::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 18, 20, 0.25),
      rgba(18, 18, 20, 0.15) 40%,
      rgba(18, 18, 20, 0.75)
    );
    pointer-events: none;
  }
  .vbox:hover .vbg {
    transform: scale(1.06);
    filter: blur(2px) brightness(0.5) saturate(1);
  }
  .vplay {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: clamp(72px, 8vw, 104px);
    aspect-ratio: 1;
    padding: 0 0 0 4px;
    border: 0;
    border-radius: 18px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.25s;
  }
  .vplay:disabled {
    cursor: not-allowed;
  }
  .vplay:not(:disabled):hover {
    transform: translate(-50%, -50%) scale(1.06);
  }
  @media (max-width: 700px) {
    .vbox {
      aspect-ratio: 4/5;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vbg {
      transition: none;
    }
  }
</style>

<script>
  // When there is a video, touching the button swaps the cover for the <video> and plays it.
  // Without one (`site.video.src` is null) the button stays disabled. Rule 13 for the lifecycle.
  let cleanup: (() => void) | undefined;
  function setup() {
    const root = document.querySelector<HTMLElement>('[data-video-section]');
    const src = root?.dataset.src;
    const play = root?.querySelector<HTMLButtonElement>('[data-play]');
    const box = root?.querySelector<HTMLElement>('[data-box]');
    const ph = root?.querySelector<HTMLElement>('[data-ph]');
    if (!root || !src || !play || !box || !ph) return;
    const speed = Number(root.dataset.speed) || 1;
    const start = () => {
      const video = document.createElement('video');
      video.src = src;
      // Set after `src`: loading resets the rate to the default one, so set both.
      video.defaultPlaybackRate = speed;
      video.playbackRate = speed;
      video.controls = true;
      video.playsInline = true;
      video.preload = 'none';
      video.poster = '/brand/video-poster-1200.webp';
      ph.hidden = true;
      box.appendChild(video);
      void video.play().catch(() => undefined);
    };
    play.addEventListener('click', start, { once: true });
    cleanup = () => play.removeEventListener('click', start);
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
