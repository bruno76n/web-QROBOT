---
import Picture from './Picture.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  text?: string;
  imageAlt: string;
  /** Buttons: `href` links, or `reload` for "try again". */
  actions: { label: string; href?: string; reload?: boolean; variant?: 'black' | 'green' }[];
}
const { title, text, imageAlt, actions } = Astro.props;
---

<section class="wrap flex flex-col items-center gap-6 py-[clamp(60px,8vw,110px)] text-center">
  <span class="dl"></span>
  <Picture
    base="/brand/q404/q404-morado-verde"
    widths={[265, 530]}
    sizes="200px"
    width={530}
    height={840}
    alt={imageAlt}
    priority
    class="h-auto w-[200px]"
  />
  <h1 class="max-w-[18ch] text-[clamp(34px,4.4vw,62px)] leading-[1.02]">{title}</h1>
  {text && <p class="lead max-w-[34ch] text-balance">{text}</p>}
  <div class="mt-2 flex flex-wrap justify-center gap-3">
    {actions.map((a, i) =>
      a.reload ? (
        <Button variant={a.variant ?? (i === 0 ? 'black' : 'black')} data-reload>
          {a.label}
        </Button>
      ) : (
        <Button
          href={a.href ?? '/'}
          variant={a.variant ?? 'black'}
          class={
            i > 0 ? 'bg-white !text-ink shadow-[inset_0_0_0_1px_var(--line)] hover:!bg-soft' : ''
          }
        >
          {a.label}
        </Button>
      ),
    )}
  </div>
</section>

<script>
  // "Intentar de nuevo": reload the page. Starts on astro:page-load, cleans on astro:before-swap.
  function setup() {
    const button = document.querySelector<HTMLButtonElement>('[data-reload]');
    const reload = () => window.location.reload();
    button?.addEventListener('click', reload);
    document.addEventListener(
      'astro:before-swap',
      () => button?.removeEventListener('click', reload),
      { once: true },
    );
  }
  document.addEventListener('astro:page-load', setup);
</script>
