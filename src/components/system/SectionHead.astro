---
/**
 * Header of a section of the page for workshops (mockup `.sec-h`): the `h2` and, if given, its lead
 * sentence. No double rule on these pages (docs/25 §7). Its styles (`.sec-h`) are in system.css,
 * shared with the questions of `Faqs`.
 */
interface Props {
  /** Id of the heading, for the section's `aria-labelledby`. */
  id: string;
  title: string;
  lead?: string;
}
const { id, title, lead } = Astro.props;
---

<header class="sec-h">
  <h2 class="t-h2" id={id}>
    {title}
  </h2>
  {lead && <p class="lead">{lead}</p>}
</header>
