---
import { site } from '@/config/site';
import { es } from '@/i18n/es';

const t = es.home.video;
const hasVideo = site.video.src !== null;
---

<section
  class="sec vsec cv"
  id="video"
  aria-labelledby="h-vid"
  data-video-section
  data-src={site.video.src ?? ''}
  data-speed={site.video.speed}
>
  <div class="wrap">
    <div class="vhead">
      <h2 id="h-vid">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
  </div>
  <div class="vwide">
    <div class="vbox" data-box>
      <div class="vbox-ph" data-ph>
        <img
          class="vbg"
          src="/brand/video-poster-1200.webp"
          alt=""
          loading="lazy"
          width="1200"
          height="675"
        />
        <span class="vtag">
          <i></i>
          {t.tag}
        </span>
        <button
          type="button"
          class="vplay"
          data-play
          disabled={!hasVideo}
          aria-label={hasVideo ? t.playLabel : t.noVideo}
        >
          <span class="vp-ic">
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
              <path d="M8 5v14l11-7z" fill="currentColor"></path>
            </svg>
          </span>
          <span class="vp-t">
            <b>{t.play}</b>
            {site.video.durationLabel}
          </span>
        </button>
        <div class="vfacts" aria-hidden="true">
          <span>
            <b>{site.video.printTime}</b>
            {t.printTime}
          </span>
          <span>
            <b>{t.videoLength}</b>
            {t.videoLengthLabel}
          </span>
          <span>
            <b>{t.layer}</b>
            {t.layerLabel}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vsec {
    padding-bottom: clamp(60px, 8vw, 120px);
  }
  .vhead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 60px;
    flex-wrap: wrap;
    margin-bottom: clamp(26px, 3.5vw, 44px);
  }
  .vhead :global(.lead) {
    max-width: 30ch;
  }
  .vwide {
    padding-inline: clamp(12px, 1.6vw, 26px);
  }
  .vbox {
    position: relative;
    aspect-ratio: 16/9;
    max-height: 86vh;
    width: 100%;
    border-radius: clamp(16px, 2vw, 28px);
    overflow: hidden;
    background: var(--ink);
  }
  .vbox :global(video),
  .vbox-ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .vbox :global(video) {
    object-fit: cover;
  }
  .vbg {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    max-width: none;
    object-fit: cover;
    filter: blur(3px) brightness(0.42) saturate(0.9);
    transform: scale(1.02);
    transition:
      transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.6s;
  }
  .vbox-ph::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 18, 20, 0.25),
      rgba(18, 18, 20, 0.15) 40%,
      rgba(18, 18, 20, 0.75)
    );
    pointer-events: none;
  }
  .vbox:hover .vbg {
    transform: scale(1.06);
    filter: blur(2px) brightness(0.5) saturate(1);
  }
  .vtag {
    position: absolute;
    z-index: 1;
    left: clamp(16px, 2.4vw, 32px);
    top: clamp(16px, 2.4vw, 30px);
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: #e4e4ea;
  }
  .vtag i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff4d4d;
    animation: rec 1.4s ease-in-out infinite;
  }
  @keyframes rec {
    50% {
      opacity: 0.25;
    }
  }
  .vplay {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 26px 10px 10px;
    border: 0;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    color: #fff;
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      background 0.25s,
      transform 0.25s;
  }
  .vplay:disabled {
    cursor: not-allowed;
  }
  .vplay:not(:disabled):hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%) scale(1.04);
  }
  .vp-ic {
    display: grid;
    place-items: center;
    width: clamp(58px, 6vw, 78px);
    aspect-ratio: 1;
    border-radius: 13px;
    background: #fff;
    color: var(--ink);
    padding-left: 3px;
  }
  .vp-t {
    font-size: 15px;
    color: #c9c9d1;
    line-height: 1.3;
  }
  .vp-t b {
    display: block;
    white-space: nowrap;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .vfacts {
    position: absolute;
    z-index: 1;
    left: clamp(16px, 2.4vw, 32px);
    right: clamp(16px, 2.4vw, 32px);
    bottom: clamp(16px, 2.4vw, 30px);
    display: flex;
    gap: clamp(20px, 4vw, 60px);
    flex-wrap: wrap;
    color: #b9b9c3;
    font-size: 14px;
  }
  .vfacts b {
    display: block;
    color: #fff;
    font-weight: 500;
    font-size: clamp(20px, 2.2vw, 32px);
    letter-spacing: -0.03em;
  }
  @media (max-width: 700px) {
    .vbox {
      aspect-ratio: 4/5;
    }
    .vfacts {
      gap: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vtag i {
      animation: none;
    }
    .vbg {
      transition: none;
    }
  }
</style>

<script>
  // When there is a video, touching the button swaps the cover for the <video> and plays it.
  // Without one (`site.video.src` is null) the button stays disabled. Rule 13 for the lifecycle.
  let cleanup: (() => void) | undefined;
  function setup() {
    const root = document.querySelector<HTMLElement>('[data-video-section]');
    const src = root?.dataset.src;
    const play = root?.querySelector<HTMLButtonElement>('[data-play]');
    const box = root?.querySelector<HTMLElement>('[data-box]');
    const ph = root?.querySelector<HTMLElement>('[data-ph]');
    if (!root || !src || !play || !box || !ph) return;
    const speed = Number(root.dataset.speed) || 1;
    const start = () => {
      const video = document.createElement('video');
      video.src = src;
      // Set after `src`: loading resets the rate to the default one, so set both.
      video.defaultPlaybackRate = speed;
      video.playbackRate = speed;
      video.controls = true;
      video.playsInline = true;
      video.preload = 'none';
      video.poster = '/brand/video-poster-1200.webp';
      ph.hidden = true;
      box.appendChild(video);
      void video.play().catch(() => undefined);
    };
    play.addEventListener('click', start, { once: true });
    cleanup = () => play.removeEventListener('click', start);
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
