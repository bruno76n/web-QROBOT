---
/**
 * Details of a module (docs/25 §6.2, mockup `.specs`): each one with its name in bold and what it
 * does, marked with a small purple square. In a gray or dark section the lines adapt.
 */
interface Props {
  items: readonly { name: string; text: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<ul class:list={['specs', className]}>
  {items.map((i) => (
    <li>
      <b>{i.name}</b>
      <span>{i.text}</span>
    </li>
  ))}
</ul>

<style>
  .specs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .specs li {
    padding: 14px 0 14px 20px;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .specs li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 23px;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--purple);
  }
  .specs b {
    display: block;
    font-size: 17px;
    letter-spacing: -0.015em;
  }
  .specs span {
    display: block;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
    margin-top: 2px;
  }
  :global(.soft) .specs li {
    border-top-color: #e2e2e8;
  }
  :global(.feat.dark) .specs span {
    color: #b9b9c3;
  }
  :global(.feat.dark) .specs li {
    border-top-color: rgba(255, 255, 255, 0.14);
  }
  :global(.feat.dark) .specs li::before {
    background: #b49af5;
  }
  /* Wide sections: the details in two columns on desktop. */
  @media (min-width: 1100px) {
    .specs.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-column-gap: 32px;
      column-gap: 32px;
    }
  }
</style>
