---
// Not-found page. Renders `ErrorPage` with links to the home and the catalog. Also served for
// unknown products and categories, which `Astro.rewrite('/404')` to this page.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ErrorPage from '@/components/site/ErrorPage.astro';
import { es } from '@/i18n/es';

export const prerender = false;
// A real 404 response, also when reached through a rewrite.
Astro.response.status = 404;
const t = es.notFound;
---

<BaseLayout title="Error 404 · Quick Robot" noindex>
  <ErrorPage
    title={t.title}
    text={t.text}
    imageAlt={t.imageAlt}
    actions={[
      { label: t.home, href: '/' },
      { label: t.catalog, href: '/catalogo' },
    ]}
  />
</BaseLayout>
