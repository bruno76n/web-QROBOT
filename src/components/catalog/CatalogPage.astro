---
// Body shared by `/catalogo` and `/catalogo/<categoria>`: title block, volume-order note, sticky
// category tabs with the product count, the product grid (or the empty state) and a prompt for
// what is not listed. Reads the category list from D1. The first four cards load eagerly.
import { listCategories } from '@/server/queries/categories';
import { es } from '@/i18n/es';
import CategoryTabs from '@/components/site/CategoryTabs.astro';
import ProductCard from '@/components/site/ProductCard.astro';
import Button from '@/components/site/Button.astro';
import type { CardView } from '@/server/queries/public';

interface Props {
  products: CardView[];
  /** Current category id, or null for "Todos". */
  category: string | null;
}
const { products, category } = Astro.props;
const categories = await listCategories();
// Name of the current category; undefined for "Todos".
const label = categories.find((c) => c.id === category)?.label;
const t = es.catalog;
---

<div class="wrap grid items-end gap-x-[70px] gap-y-10 pt-[clamp(56px,7vw,100px)] pb-[clamp(36px,4vw,56px)] min-[901px]:grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)]">
  <div>
    <h1 class="text-[clamp(50px,7.6vw,124px)] leading-[.92] tracking-[-0.06em]">
      {t.titleLines[0]} <span class="block text-purple">{t.titleLines[1]}</span>
    </h1>
    <p class="lead mt-6 max-w-[34ch]">{t.lead}</p>
  </div>
  <div class="rounded-[22px] bg-soft p-[clamp(22px,2.6vw,32px)]">
    <b class="block text-[clamp(22px,2vw,28px)] leading-[1.15] font-semibold tracking-[-0.03em]">
      {t.volumeTitle}
    </b>
    <p class="mt-3 text-base text-ink-2">{t.volumeText}</p>
  </div>
</div>

<div class="sticky top-[var(--top)] z-20 border-y border-line bg-white/90 backdrop-blur-md max-[760px]:static">
  <div class="wrap flex min-h-16 flex-wrap items-center justify-between gap-3">
    <CategoryTabs current={category} categories={categories} />
    <p class="text-sm text-ink-2" aria-live="polite">
      <b class="text-ink">{label ?? t.all}</b> · {t.count(products.length)}
    </p>
  </div>
</div>

<div class="wrap">
  {products.length === 0 ? (
    <div class="py-[60px] text-center text-ink-2">
      <p>{t.emptyTitle}</p>
      <p class="mt-3">
        <a href="/catalogo" class="text-purple no-underline hover:underline">
          {t.emptyLink}
        </a>
      </p>
    </div>
  ) : (
    <ul
      aria-label={t.gridLabel}
      class="m-0 mt-[clamp(28px,3.5vw,44px)] grid list-none grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-x-[clamp(16px,2vw,26px)] gap-y-[clamp(26px,3vw,40px)] p-0"
    >
      {products.map((p, i) => (
        <li>
          <ProductCard product={p} priority={i < 4} />
        </li>
      ))}
    </ul>
  )}
  <p class="mt-[clamp(50px,6vw,80px)] flex flex-wrap items-center justify-between gap-5 border-t border-line py-[26px] text-[15px] text-ink-2">
    <span>{t.notFoundText}</span>
    <Button
      href="/#pedido"
      class="bg-white !text-ink shadow-[inset_0_0_0_1px_var(--line)] hover:!bg-white hover:shadow-[inset_0_0_0_1px_#c8c8cf]"
    >
      {t.notFoundButton}
    </Button>
  </p>
  <p class="pb-2 text-[13px] text-ink-2">{t.footnote}</p>
</div>
